{ %CPU=aarch64,arm,x86_64,i386,wasm32 }
{ %OPT=-O2 -OoNOFASTMATH }
program tpc24softfma;
{$mode objfpc}{$Q-}{$R-}
uses Math;
type
  TPC24DoubleBits = record
    case Boolean of
      False: (value: Double);
      True: (bits: QWord);
  end;
{ Exercise the private software fallback on hardware-FMA hosts too. }
{$I ../../rtl/inc/pc24fma.inc}
const
  { a, b, c, correctly rounded a*b+c. Cover cancellation, an overflowing
    intermediate product, subnormal ties, and normal ties in both directions. }
  Cases: array[0..18,0..3] of QWord = (
    ($3FF0000000000001, $3FEFFFFFFFFFFFFE, $BFF0000000000000, $B970000000000000),
    ($7FEFFFFFFFFFFFFF, $4000000000000000, $FFEFFFFFFFFFFFFF, $7FEFFFFFFFFFFFFF),
    ($0000000000000001, $3FE0000000000000, $0000000000000000, $0000000000000000),
    ($0000000000000001, $3FF8000000000000, $0000000000000000, $0000000000000002),
    ($0010000000000001, $3FE0000000000000, $0000000000000000, $0008000000000000),
    ($0010000000000003, $3FE0000000000000, $0000000000000000, $0008000000000002),
    ($001FFFFFFFFFFFFF, $3FE0000000000000, $0000000000000000, $0010000000000000),
    ($0010000000000000, $0010000000000000, $0000000000000001, $0000000000000001),
    ($8010000000000000, $0010000000000000, $0000000000000001, $0000000000000001),
    ($0010000000000000, $3FEFFFFFFFFFFFFF, $800FFFFFFFFFFFFF, $0000000000000000),
    ($7FEFFFFFFFFFFFFF, $3FF0000000000001, $FFEFFFFFFFFFFFFF, $7CAFFFFFFFFFFFFF),
    ($3FF0000000000000, $3FF0000000000000, $BFF0000000000000, $0000000000000000),
    ($8000000000000000, $3FF0000000000000, $8000000000000000, $8000000000000000),
    ($7FD0123456789ABC, $003FEDCBA9876543, $C017DBF487FCB923, $40006C56301C3CB1),
    ($3FF0000000000001, $3FF0000000000001, $BC90000000000000, $3FF0000000000002),
    ($3FF0000000000000, $3FF0000000000000, $3CA0000000000000, $3FF0000000000000),
    ($3FF0000000000001, $3FF0000000000000, $3CA0000000000000, $3FF0000000000002),
    ($0010000000000001, $3FE0000000000000, $0000000000000001, $0008000000000002),
    ($0010000000000003, $3FE0000000000000, $0000000000000001, $0008000000000002)
  );
var
  a,b,c,r: TPC24DoubleBits;
  i: LongInt;
begin
  SetExceptionMask([exInvalidOp,exDenormalized,exZeroDivide,
    exOverflow,exUnderflow,exPrecision]);
  for i:=Low(Cases) to High(Cases) do
    begin
      a.bits:=Cases[i,0]; b.bits:=Cases[i,1]; c.bits:=Cases[i,2];
      r.value:=pc24_fma(a.value,b.value,c.value);
      if r.bits<>Cases[i,3] then Halt(i+1);
    end;
end.
